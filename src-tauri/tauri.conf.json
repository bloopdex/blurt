{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blurt",
  "version": "0.5.0",
  "identifier": "app.blurt.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Blurt",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "backgroundColor": "#0D0E11"
      },
      {
        "label": "overlay",
        "title": "Blurt overlay",
        "width": 840,
        "height": 540,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/library/covers/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Blurt",
    "copyright": "© 2026 Mohammed Rami Benhamida. MIT License.",
    "category": "Music",
    "shortDescription": "A soundboard that plays straight into your microphone",
    "longDescription": "Blurt plays sound effects, clips and music into a virtual microphone so everyone on Discord, Zoom, Teams, Meet or in-game voice chat hears them.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "../design/installer-header.bmp",
        "sidebarImage": "../design/installer-sidebar.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
