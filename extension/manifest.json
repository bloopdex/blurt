{
  "manifest_version": 3,
  "name": "Send to Blurt",
  "version": "1.0.0",
  "description": "Send a YouTube, TikTok or Instagram video to the Blurt soundboard in one click, ready to trim and play into your mic.",
  "homepage_url": "https://blurt.bloopdex.com/",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Send to Blurt",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:7270/*"],
  "commands": {
    "send-current-tab": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Send this video to Blurt"
    }
  }
}
